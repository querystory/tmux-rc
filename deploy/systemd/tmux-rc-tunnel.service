[Unit]
Description=tmux-rc tunnel client (<slug>.tun.qs.dev -> the local daemon)
PartOf=tmux-rc.target
After=network-online.target
# The tunnel is optional: with no env file there is nothing to configure the client with,
# so skip the unit cleanly (inactive, not failed) instead of crash-looping. Copy
# deploy/tunnel.env.example there, then `systemctl --user start tmux-rc-tunnel`.
ConditionPathExists=%h/.config/tmux-rc/tunnel.env
# The relay caps a connection at ~1h and the client reconnects itself; systemd is the
# backstop for the failure the client cannot see — process alive, no longer registered.
# Tolerate slow flapping, still fail a real crash-loop. (StartLimit*/Condition* are
# [Unit] keys — systemd silently ignores them under [Service].)
StartLimitIntervalSec=1h
StartLimitBurst=20
# Deliberately NOT ordered after tmux-rc.service: the client retries its dial with
# backoff, so starting first is harmless, and coupling the two would mean a daemon
# restart bounced the tunnel for no reason.

[Service]
# A real installed binary, never /tmp (which a reboot erases — that cost us a dead
# phone once already). Build from qsi-automation/tunnel: `go build -o
# ~/.local/bin/tunnel-client ./client`.
ExecStart=%h/.local/bin/tunnel-client
# NO command-line flags: the EnvironmentFile carries TUNNEL_SLUG/PORT/OWNER and
# GOOGLE_APPLICATION_CREDENTIALS (a service-account key — self-refreshing, no human
# reauth). Passing bare flags instead silently falls back to user ADC, which the org
# reauth policy kills daily.
EnvironmentFile=%h/.config/tmux-rc/tunnel.env
Restart=always
RestartSec=5

[Install]
WantedBy=tmux-rc.target
