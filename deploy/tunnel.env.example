# Copy to ~/.config/tmux-rc/tunnel.env — read by tmux-rc-tunnel.service.
# Kept OUT of the unit (and out of this repo's .env) because it configures a binary
# this repo doesn't own: the tunnel client is built from qsi-automation/tunnel.

# Your subdomain: <slug>.tun.qs.dev
TUNNEL_SLUG=your-host-tmux
# Where the daemon listens (see TMUXRC_PORT).
TUNNEL_PORT=18030
TUNNEL_OWNER=you@example.com
# The auth mode that survives unattended operation: a service-account key, refreshed by
# the client itself. User ADC would need a browser reauth as often as the org policy says.
GOOGLE_APPLICATION_CREDENTIALS=/home/you/.config/tunnel/sa-key.json
