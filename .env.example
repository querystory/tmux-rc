# Google Cloud project for Vertex AI (Gemini Flash Lite classification pass).
# ADC (application default credentials) must be available on the host.
GOOGLE_CLOUD_PROJECT=qs-backend-dev
VERTEX_AI_REGION_GEMINI=global

# tmux target for Milestone 1 (single pane). Leave unset to auto-pick the first pane.
# TERMIPHONE_TARGET=work:0.0

# HTTP bind
TERMIPHONE_HOST=0.0.0.0
TERMIPHONE_PORT=8080
