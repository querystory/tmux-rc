# Google Cloud project for Vertex AI (Gemini Flash Lite classification pass).
GOOGLE_CLOUD_PROJECT=qs-backend-dev
VERTEX_AI_REGION_GEMINI=global

# Credentials for Vertex. The daemon is a long-running unattended service, so it uses a
# long-lived service-account key rather than developer ADC (which expires and needs a
# browser reauth, wedging the daemon — see docs/design/durable-vertex-auth.md). google-auth
# honors this env var with no code change. Mint with:
#   gcloud iam service-accounts keys create ~/.config/tmux-rc/vertex-sa.json \
#     --iam-account=tmux-rc-classifier@qs-backend-dev.iam.gserviceaccount.com
#   chmod 600 ~/.config/tmux-rc/vertex-sa.json
# Use an absolute path (google-auth does not expand ~).
GOOGLE_APPLICATION_CREDENTIALS=/home/YOU/.config/tmux-rc/vertex-sa.json

# tmux target for Milestone 1 (single pane). Leave unset to auto-pick the first pane.
# TMUXRC_TARGET=work:0.0

# HTTP bind. The default is 127.0.0.1: the API is unauthenticated and /send injects
# keystrokes, so reaching it from the LAN must be a deliberate choice, not a default.
# Set 0.0.0.0 to browse from a phone on the same network.
TMUXRC_HOST=0.0.0.0
# 18030, not 8080: every dev box already has something on 8080. 1803X spells R,C.
TMUXRC_PORT=18030

# Docs site served at /docs. Point at the Hugo build output (`make docs`, built with
# --baseURL /docs/). Unset = default docs-site/serve next to the package; leave the dir
# absent to not serve docs (dev uses `make docs-dev`, Hugo's own hot-reload server). Use
# an absolute path when running the daemon from outside the checkout.
# TMUXRC_DOCS_DIR=/absolute/path/to/tmux-rc/docs-site/serve

# Benchmark telemetry (optional). Unset endpoint = telemetry disabled (daemon runs
# normally offline). Points at an OTLP/gRPC receiver; the qsi-automation otel-receiver
# writes to gs://qsi-otel-data/. Bearer token goes in OTEL_EXPORTER_OTLP_HEADERS.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4319
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer <token>
# TMUXRC_QSDEBUG=1   # also send raw pane text + model output JSON (privacy: contents → sink)

# Live Mode (voice) — talk to your whole session. Uses Vertex like the classifier but
# needs a Live-capable model on a region that serves it (NOT flash-lite / "global").
# OFF by default (the voice UX is still being tuned); set to 1 to show the mic button
# and allow /api/live-mode. The dim/placeholder markers and window naming it rides in
# with are always on — they help the phone cards regardless of this flag.
# TMUXRC_LIVE_MODE=1
# TMUXRC_LIVE_MODEL=gemini-live-2.5-flash-native-audio
# TMUXRC_LIVE_REGION=us-central1

# The daemon prefers IPv4 for outbound connections (an advertised-but-dead IPv6 route
# otherwise starves streaming handshakes). Set to 0 if your v6 works and your v4 doesn't.
# TMUXRC_PREFER_IPV4=1
